# Recommended: copy this file to .env.local for local development.
# Keep all secrets server-side and never expose them in the browser.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_key
N8N_LEAD_WEBHOOK_URL=https://your-n8n.example.com/webhook/travel-lead
N8N_BOOKING_WEBHOOK_URL=https://your-n8n.example.com/webhook/vietjourney-booking
N8N_WEBHOOK_SECRET=replace-with-a-random-secret
SALES_UPDATE_SECRET=replace-with-a-separate-random-secret
CRON_SECRET=replace-with-another-random-secret
OPENROUTER_API_KEY=your_openrouter_api_key
APP_ORIGIN=http://localhost:3000
