      "parameters": {
        "jsCode": "\nconst esc = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst flat = (v) => {\n  if (v === undefined || v === null) return '';\n  if (Array.isArray(v)) return v.map(x => (x && typeof x === 'object') ? JSON.stringify(x) : String(x)).join(', ');\n  if (typeof v === 'object') return JSON.stringify(v);\n  return String(v);\n};\nconst cap = (v, n = 500) => { const s = flat(v).trim(); return s.length > n ? s.slice(0, n) + '…' : s; };\nconst oneLine = (v, n = 80) => flat(v).replace(/[\\r\\n\\t]+/g, ' ').trim().slice(0, n);\nconst safeLink = (v) => (/^https?:\\/\\/\\S+$/i.test(String(v ?? '').trim()) ? String(v).trim() : '');\n\nconst visibleRows = (rows) => rows.map(([l, v]) => [l, cap(v)]).filter(([, v]) => v !== '');\n\nconst renderHtml = (title, intro, sections, link) => {\n  const parts = ['<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#222;max-width:640px\">',\n    `<h2 style=\"margin:0 0 8px\">${esc(title)}</h2>`];\n  if (intro) parts.push(`<p style=\"margin:0 0 12px\">${esc(intro)}</p>`);\n  for (const [heading, rows] of sections) {\n    const shown = visibleRows(rows);\n    if (!shown.length) continue;\n    parts.push(`<h3 style=\"margin:16px 0 6px;font-size:15px\">${esc(heading)}</h3>`);\n    parts.push('<table style=\"border-collapse:collapse;width:100%\">');\n    for (const [l, v] of shown) {\n      parts.push(`<tr><td style=\"padding:4px 8px;border:1px solid #ddd;background:#f7f7f7;width:35%\">${esc(l)}</td><td style=\"padding:4px 8px;border:1px solid #ddd\">${esc(v)}</td></tr>`);\n    }\n    parts.push('</table>');\n  }\n  if (link) parts.push(`<p style=\"margin-top:16px\"><a href=\"${esc(link)}\">Mở để xử lý</a></p>`);\n  return parts.concat(['</div>']).join('');\n};\n\nconst renderText = (title, intro, sections, link) => {\n  const lines = [title, ''];\n  if (intro) lines.push(intro, '');\n  for (const [heading, rows] of sections) {\n    const shown = visibleRows(rows);\n    if (!shown.length) continue;\n    lines.push(`== ${heading} ==`);\n    for (const [l, v] of shown) lines.push(`${l}: ${v}`);\n    lines.push('');\n  }\n  if (link) lines.push(`Link xử lý: ${link}`);\n  return lines.join('\\n');\n};\n\nconst d = $('Normalize Payload').first().json;\nconst to = $('Resolve Customer Email').first().json.customer_email;\nconst br = (d.booking_request && typeof d.booking_request === 'object' && !Array.isArray(d.booking_request)) ? d.booking_request : {};\nconst pick = (...keys) => { for (const k of keys) { const v = br[k] ?? d[k]; if (v !== undefined && v !== null && flat(v).trim() !== '') return v; } return ''; };\n\nconst name = oneLine(d.name ?? d.customer_name ?? br.name ?? '', 80);\nconst title = 'Booking của bạn đã được đội ngũ tư vấn xác nhận';\nconst intro = (name ? `Xin chào ${name}, ` : 'Xin chào, ') +\n  'đội ngũ tư vấn VietJourney đã xác nhận booking của bạn.';\n\n// Chỉ hiển thị lại thông tin do backend gửi; không thêm giá, lịch khởi hành, giữ chỗ hay dịch vụ.\nconst sections = [\n  ['Thông tin ghi nhận trong yêu cầu của bạn', [\n    ['Tour', pick('selected_tour_name', 'tour_name')],\n    ['Điểm đến', pick('destination')],\n    ['Ngày đi theo yêu cầu', pick('travel_date')],\n    ['Số người', pick('party_size')],\n    ['Mã tham chiếu', d.lead_id]]]\n];\nconst footer = 'Email này chỉ thông báo rằng Sales đã xác nhận booking. Email không thay thế báo giá hay xác nhận dịch vụ chi tiết; vui lòng dựa vào thông tin do nhân viên tư vấn VietJourney cung cấp trực tiếp cho bạn.';\n\nconst html = renderHtml(title, intro, sections, '').replace(/<\\/div>$/, `<p style=\"margin-top:16px;color:#555\">${esc(footer)}</p></div>`);\nconst text = renderText(title, intro, sections, '') + '\\n\\n' + footer;\n\nreturn [{ json: {\n  email_to: to,\n  email_subject: '[VietJourney] Booking của bạn đã được xác nhận bởi đội ngũ tư vấn',\n  email_html: html,\n  email_text: text\n} }];\n"
      },
