    {
      "parameters": {
        "jsCode": "\nconst esc = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst flat = (v) => {\n  if (v === undefined || v === null) return '';\n  if (Array.isArray(v)) return v.map(x => (x && typeof x === 'object') ? JSON.stringify(x) : String(x)).join(', ');\n  if (typeof v === 'object') return JSON.stringify(v);\n  return String(v);\n};\nconst cap = (v, n = 500) => { const s = flat(v).trim(); return s.length > n ? s.slice(0, n) + '…' : s; };\nconst oneLine = (v, n = 80) => flat(v).replace(/[\\r\\n\\t]+/g, ' ').trim().slice(0, n);\nconst safeLink = (v) => (/^https?:\\/\\/\\S+$/i.test(String(v ?? '').trim()) ? String(v).trim() : '');\n\nconst visibleRows = (rows) => rows.map(([l, v]) => [l, cap(v)]).filter(([, v]) => v !== '');\n\nconst renderHtml = (title, intro, sections, link) => {\n  const parts = ['<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#222;max-width:640px\">',\n    `<h2 style=\"margin:0 0 8px\">${esc(title)}</h2>`];\n  if (intro) parts.push(`<p style=\"margin:0 0 12px\">${esc(intro)}</p>`);\n  for (const [heading, rows] of sections) {\n    const shown = visibleRows(rows);\n    if (!shown.length) continue;\n    parts.push(`<h3 style=\"margin:16px 0 6px;font-size:15px\">${esc(heading)}</h3>`);\n    parts.push('<table style=\"border-collapse:collapse;width:100%\">');\n    for (const [l, v] of shown) {\n      parts.push(`<tr><td style=\"padding:4px 8px;border:1px solid #ddd;background:#f7f7f7;width:35%\">${esc(l)}</td><td style=\"padding:4px 8px;border:1px solid #ddd\">${esc(v)}</td></tr>`);\n    }\n    parts.push('</table>');\n  }\n  if (link) parts.push(`<p style=\"margin-top:16px\"><a href=\"${esc(link)}\">Mở để xử lý</a></p>`);\n  return parts.concat(['</div>']).join('');\n};\n\nconst renderText = (title, intro, sections, link) => {\n  const lines = [title, ''];\n  if (intro) lines.push(intro, '');\n  for (const [heading, rows] of sections) {\n    const shown = visibleRows(rows);\n    if (!shown.length) continue;\n    lines.push(`== ${heading} ==`);\n    for (const [l, v] of shown) lines.push(`${l}: ${v}`);\n    lines.push('');\n  }\n  if (link) lines.push(`Link xử lý: ${link}`);\n  return lines.join('\\n');\n};\n\nconst d = $('Normalize Payload').first().json;\nconst leadId = oneLine(d.lead_id, 120);\n\n// Không đưa các trường trông nhạy cảm vào email; chỉnh regex/allowlist theo payload thực tế nếu cần.\nconst SENSITIVE = /(password|passwd|secret|token|api[_-]?key|card|cvv|cvc|otp|passport|cccd|cmnd|national[_-]?id|id[_-]?number|ssn)/i;\nconst br = (d.booking_request && typeof d.booking_request === 'object' && !Array.isArray(d.booking_request))\n  ? d.booking_request : { booking_request: d.booking_request };\nconst bookingRows = Object.entries(br).filter(([k]) => !SENSITIVE.test(k)).slice(0, 40);\n\nconst sections = [\n  ['Thông tin liên hệ', [\n    ['Họ tên', d.name ?? d.customer_name], ['Email', d.email ?? d.customer_email],\n    ['Số điện thoại', d.phone]]],\n  ['Chi tiết yêu cầu booking (theo dữ liệu backend gửi)', bookingRows],\n  ['Lead', [\n    ['lead_id', d.lead_id], ['Mức lead (lead_level)', d.lead_level], ['Ưu tiên (lead_priority)', d.lead_priority],\n    ['Tour đã chọn', d.selected_tour_name]]],\n  ['Nguồn / UTM', [\n    ['Nguồn', d.source], ['utm_source', d.utm_source], ['utm_medium', d.utm_medium],\n    ['utm_campaign', d.utm_campaign]]]\n];\nconst link = safeLink(d.lead_url);\nconst title = 'Yêu cầu booking mới';\nconst intro = `Khách vừa gửi yêu cầu booking (lead_id ${leadId}). Sales vui lòng liên hệ và xử lý.`;\n\nreturn [{ json: {\n  email_subject: `[VietJourney] Yêu cầu booking mới - ${leadId}`,\n  email_html: renderHtml(title, intro, sections, link),\n  email_text: renderText(title, intro, sections, link)\n} }];\n"
      },
