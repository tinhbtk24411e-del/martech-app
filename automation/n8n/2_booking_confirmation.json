    {
      "parameters": {
        "jsCode": "\nconst d = $('Normalize Payload').first().json;\nconst br = (d.booking_request && typeof d.booking_request === 'object' && !Array.isArray(d.booking_request)) ? d.booking_request : {};\nconst isValid = (e) => e.length > 0 && e.length <= 254 && /^[^\\s@<>(),;:\"\\\\]+@[^\\s@<>(),;:\"\\\\]+\\.[^\\s@<>(),;:\"\\\\]{2,}$/.test(e);\nconst email = [d.email, d.customer_email, br.email, br.customer_email]\n  .filter(v => typeof v === 'string')\n  .map(v => v.trim())\n  .find(isValid) || '';\nreturn [{ json: { customer_email: email, customer_email_valid: email !== '' } }];\n"
